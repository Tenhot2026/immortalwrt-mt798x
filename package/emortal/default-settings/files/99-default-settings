#!/bin/sh

uci -q get system.@imm_init[0] > "/dev/null" || uci -q add system imm_init > "/dev/null"

if ! uci -q get system.@imm_init[0].lang > "/dev/null"; then
	case "$(cat /tmp/sysinfo/board_name)" in
	tenhot,wr6000k)
		uci -q set luci.main.lang="zh_cn"
		;;
	*)
		uci -q set luci.main.lang="auto"
		;;
	esac
	uci -q commit luci

	uci -q set system.@imm_init[0].lang="1"
	uci -q commit system
fi

uci -q set luci.main.socket="/var/run/ubus.sock"
uci -q commit luci

#if ! uci -q get system.@imm_init[0].anon_mount > "/dev/null"; then
#	uci -q set fstab.@global[0].anon_mount="1"
#	uci -q commit fstab

#	uci -q set system.@imm_init[0].anon_mount="1"
#	uci -q commit system
#fi

ln -sf "/sbin/ip" "/usr/bin/ip"

[ ! -e "/bin/bash" ] || sed -i "s|root:x:0:0:root:/root:/bin/ash|root:x:0:0:root:/root:/bin/bash|g" "/etc/passwd"

sed -i "/log-facility/d" "/etc/dnsmasq.conf"
echo "log-facility=/dev/null" >> "/etc/dnsmasq.conf"

rm -rf "/tmp/luci-modulecache"
rm -f "/tmp/luci-indexcache"

# Tenhot first-boot wireless defaults. Keep this after the common setup so
# retries do not prevent the other default settings from being applied.
. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name)" in
	tenhot,wr6000k) ;;
	*) exit 0 ;;
esac

# Retain the user's choice across reboots and upgrades that keep settings.
[ "$(uci -q get system.@system[0].tenhot_wifi_defaults)" = "1" ] && exit 0

# MTK creates wireless sections during net hotplug. Also request detection
# here so first-boot defaults do not depend on that event having finished.
/sbin/wifi config || exit 1

set_tenhot_2g_defaults() {
	local section="$1"
	local driver band

	config_get driver "$section" type
	config_get band "$section" band
	[ "$driver" = "mtwifi" ] && [ "$band" = "2g" ] || return 0

	uci -q set "wireless.$section.htmode=HE20" || tenhot_failed=1
	tenhot_2g_found=1
}

set_tenhot_ap_defaults() {
	local section="$1"
	local device mode driver band ssid

	config_get device "$section" device
	config_get mode "$section" mode
	[ "$mode" = "ap" ] && [ -n "$device" ] || return 0
	config_get driver "$device" type
	config_get band "$device" band
	[ "$driver" = "mtwifi" ] || return 0

	case "$band" in
		2g) ssid="Openwrt-2.4G" ;;
		5g) ssid="Openwrt-5G" ;;
		*) return 0 ;;
	esac

	uci -q set "wireless.$section.ssid=$ssid" || tenhot_failed=1
	uci -q set "wireless.$section.encryption=psk2+ccmp" || tenhot_failed=1
	uci -q set "wireless.$section.key=9876543210" || tenhot_failed=1
	case "$band" in
		2g) tenhot_2g_ap_found=1 ;;
		5g) tenhot_5g_ap_found=1 ;;
	esac
}

tenhot_2g_found=0
tenhot_2g_ap_found=0
tenhot_5g_ap_found=0
tenhot_failed=0
config_load wireless || exit 1
config_foreach set_tenhot_2g_defaults wifi-device
config_foreach set_tenhot_ap_defaults wifi-iface

# A nonzero exit leaves this script available for retry on the next boot.
[ "$tenhot_2g_found" = "1" ] && [ "$tenhot_2g_ap_found" = "1" ] &&
	[ "$tenhot_5g_ap_found" = "1" ] && [ "$tenhot_failed" = "0" ] || exit 1
uci -q commit wireless || exit 1

uci -q set system.@system[0].tenhot_wifi_defaults=1 || exit 1
uci -q commit system || exit 1

exit 0
