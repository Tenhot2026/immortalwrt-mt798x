diff --git a/drivers/mtd/nand/spi/wodposit.c b/drivers/mtd/nand/spi/wodposit.c
new file mode 100644
index 0000000..7c55c7e
--- /dev/null
+++ b/drivers/mtd/nand/spi/wodposit.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 Wodposit
+ */
+
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/mtd/spinand.h>
+
+#define SPINAND_MFR_WODPOSIT		0xA5
+
+static SPINAND_OP_VARIANTS(read_cache_variants,
+		SPINAND_PAGE_READ_FROM_CACHE_QUADIO_OP(0, 2, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_X4_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_DUALIO_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_X2_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(true, 0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(false, 0, 1, NULL, 0));
+
+static SPINAND_OP_VARIANTS(write_cache_variants,
+		SPINAND_PROG_LOAD_X4(true, 0, NULL, 0),
+		SPINAND_PROG_LOAD(true, 0, NULL, 0));
+
+static SPINAND_OP_VARIANTS(update_cache_variants,
+		SPINAND_PROG_LOAD_X4(false, 0, NULL, 0),
+		SPINAND_PROG_LOAD(false, 0, NULL, 0));
+
+static int wps3ns0xw_ooblayout_ecc(struct mtd_info *mtd, int section,
+				   struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	region->offset = 32;
+	region->length = 32;
+
+	return 0;
+}
+
+static int wps3ns0xw_ooblayout_free(struct mtd_info *mtd, int section,
+				    struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	/* Reserve 2 bytes for BBM */
+	region->offset = 2;
+	region->length = 30;
+
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops wps3ns0xw_ooblayout = {
+	.ecc = wps3ns0xw_ooblayout_ecc,
+	.free = wps3ns0xw_ooblayout_free,
+};
+
+static int wps3ns04w_ooblayout_ecc(struct mtd_info *mtd, int section,
+				   struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	region->offset = 64;
+	region->length = 64;
+
+	return 0;
+}
+
+static int wps3ns04w_ooblayout_free(struct mtd_info *mtd, int section,
+				    struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	/* Reserve 2 bytes for BBM */
+	region->offset = 2;
+	region->length = 62;
+
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops wps3ns04w_ooblayout = {
+	.ecc = wps3ns04w_ooblayout_ecc,
+	.free = wps3ns04w_ooblayout_free,
+};
+
+static const struct spinand_info wodposit_spinand_table[] = {
+	SPINAND_INFO("WPS3NS01W",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xA0, 0x81),
+		     NAND_MEMORG(1, 2048, 64, 64, 1024, 20, 1, 1, 1),
+		     NAND_ECCREQ(4, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&wps3ns0xw_ooblayout, NULL)),
+	SPINAND_INFO("WPS3NS02W",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xA0, 0x82),
+		     NAND_MEMORG(1, 2048, 64, 64, 2048, 40, 1, 1, 1),
+		     NAND_ECCREQ(4, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&wps3ns0xw_ooblayout, NULL)),
+	SPINAND_INFO("WPS3NS04W",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xA0, 0x83),
+		     NAND_MEMORG(1, 4096, 128, 64, 2048, 40, 1, 1, 1),
+		     NAND_ECCREQ(4, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&wps3ns04w_ooblayout, NULL)),
+};
+
+static const struct spinand_manufacturer_ops wodposit_spinand_manuf_ops = {
+};
+
+const struct spinand_manufacturer wodposit_spinand_manufacturer = {
+	.id = SPINAND_MFR_WODPOSIT,
+	.name = "Wodposit",
+	.chips = wodposit_spinand_table,
+	.nchips = ARRAY_SIZE(wodposit_spinand_table),
+	.ops = &wodposit_spinand_manuf_ops,
+};
